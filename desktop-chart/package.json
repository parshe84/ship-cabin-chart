{
  "name": "ship-cabin-chart",
  "productName": "Ship Cabin Chart",
  "version": "0.1.0",
  "description": "Позиция судна на карте: принимает NMEA от Android-телефона по Wi-Fi",
  "main": "src/main.js",
  "author": "parshe84",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.parshe84.shipcabinchart",
    "files": [
      "src/**/*",
      "node_modules/leaflet/dist/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ShipCabinChart-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
