{
  "name": "ship-cabin-chart",
  "productName": "Ship Cabin Chart",
  "version": "1.8.0",
  "description": "Ship position on a world nautical chart, received as NMEA from an Android phone over Wi-Fi",
  "main": "src/main.js",
  "author": "parshe84",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build-map": "node scripts/build-world-map.js",
    "dist:win": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "fflate": "0.8.2",
    "geojson-vt": "4.0.2",
    "leaflet": "1.9.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "mapshaper": "0.6.102"
  },
  "build": {
    "appId": "com.parshe84.shipcabinchart",
    "files": [
      "src/**/*",
      "node_modules/leaflet/dist/**/*",
      "node_modules/geojson-vt/geojson-vt.js",
      "node_modules/@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2",
      "node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2"
    ],
    "asarUnpack": [
      "src/enc-worker.js",
      "src/enc-convert.js",
      "src/s57/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ShipCabinChart-${version}-portable.exe"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parshe84/ship-cabin-chart.git"
  }
}
